rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole(role) {
      return request.auth != null &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == role &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('active', true) == true;
    }
    function isManager() {
      return hasRole('manager') && request.auth.token.email == 'roisuissa6@gmail.com';
    }
    function activeTechnician(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid)) &&
        get(/databases/$(database)/documents/roles/$(uid)).data.role == 'technician' &&
        get(/databases/$(database)/documents/roles/$(uid)).data.active == true;
    }

    match /roles/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isManager();
      allow list: if isManager();
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email == 'roisuissa6@gmail.com'
        && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'active', 'createdAt'])
        && request.resource.data.role == 'manager'
        && request.resource.data.name == 'נימר'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && request.resource.data.createdAt is string;
      allow create: if isManager() && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'active', 'createdAt'])
        && request.resource.data.role == 'technician'
        && request.resource.data.active == true
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.createdAt is string;
      allow update: if isManager() && resource.data.role == 'technician'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
      allow delete: if false;
    }

    match /metadata/{id} {
      allow get: if id in ['serial', 'keySerial'] && isManager();
      allow list: if false;
      allow create, update: if id in ['serial', 'keySerial'] && isManager()
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last is int
        && request.resource.data.last >= 1
        && request.resource.data.last <= (id == 'keySerial' ? 999999999 : 9999999999)
        && (!exists(/databases/$(database)/documents/metadata/$(id)) || request.resource.data.last > resource.data.last);
      allow delete: if false;
    }

    match /aircraftConstants/{id} {
      allow get, list: if isManager();
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['squadron', 'aircraft', 'constants', 'updatedAt', 'updatedBy'])
        && request.resource.data.squadron in ['101', '105', '109', 'מנ״ט']
        && request.resource.data.aircraft is string
        && id == request.resource.data.squadron + '_' + request.resource.data.aircraft
        && request.resource.data.constants is map
        && request.resource.data.constants.keys().hasOnly(['HUD', 'CTVS', 'CAMERA', 'TFL', 'INS'])
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /keyLoads/{id} {
      allow get, list: if isManager() || (hasRole('technician') && request.auth.uid in resource.data.teamUids);
      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['date', 'time', 'squadron', 'shelter', 'teamUids', 'teamNames', 'rows', 'aircraftIds', 'period', 'dispatcherSignature', 'status', 'createdAt', 'serial'])
        && request.resource.data.serial is string
        && request.resource.data.serial.matches('K-[0-9]{9}')
        && request.resource.data.status == 'open'
        && request.resource.data.teamUids is list
        && request.resource.data.teamUids.size() >= 2
        && request.resource.data.rows is list
        && request.resource.data.rows.size() > 0
        && request.resource.data.aircraftIds.size() == request.resource.data.rows.size()
        && request.resource.data.dispatcherSignature is string
        && request.resource.data.dispatcherSignature.size() > 100;
      allow update: if isManager()
        && !('serial' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['serial'])
        && request.resource.data.serial is string
        && request.resource.data.serial.matches('K-[0-9]{9}');
      allow update: if hasRole('technician')
        && resource.data.status == 'open'
        && request.auth.uid in resource.data.teamUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'work', 'completedAt', 'completedBy'])
        && request.resource.data.status == 'closed'
        && request.resource.data.completedBy == request.auth.uid
        && request.resource.data.completedAt is string
        && request.resource.data.work.actions is list
        && request.resource.data.work.actions.size() == 12
        && request.resource.data.work.actions.hasOnly([true]);
      allow update: if isManager()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerNotes'])
        && request.resource.data.managerNotes is string
        && request.resource.data.managerNotes.size() > resource.data.get('managerNotes', '').size()
        && request.resource.data.managerNotes.size() <= 2000;
      allow update: if isManager()
        && resource.data.status == 'closed'
        && request.resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reopenedAt', 'reopenedBy', 'reopenEvents'])
        && request.resource.data.reopenedBy == request.auth.uid
        && request.resource.data.reopenedAt is string
        && request.resource.data.reopenEvents is list
        && request.resource.data.reopenEvents.size() == resource.data.get('reopenEvents', []).size() + 1
        && request.resource.data.reopenEvents.hasAll(resource.data.get('reopenEvents', []))
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].by == request.auth.uid
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].at == request.resource.data.reopenedAt
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].priorCompletedAt == resource.data.completedAt;
      allow delete: if false;
    }

    match /keyHistory/{id} {
      allow get, list: if isManager();
      allow create, update: if hasRole('technician')
        && request.resource.data.keys().hasOnly(['squadron', 'aircraft', 'date', 'period', 'completedAt', 'loadId'])
        && (!exists(/databases/$(database)/documents/keyHistory/$(id)) || request.resource.data.completedAt > resource.data.completedAt)
        && id == request.resource.data.squadron + '_' + request.resource.data.aircraft
        && request.resource.data.loadId is string
        && existsAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId))
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.status == 'closed'
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.completedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.squadron == request.resource.data.squadron
        && request.resource.data.aircraft in getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.aircraftIds
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.period == request.resource.data.period
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.completedAt == request.resource.data.completedAt;
      allow delete: if false;
    }

    match /issues/{id} {
      allow get, list: if isManager() || (hasRole('technician') && resource.data.assigneeUid == request.auth.uid);
      allow create: if isManager()
        && request.resource.data.keys().hasOnly(['sheet', 'status', 'createdAt', 'assigneeUid', 'assigneeName'])
        && request.resource.data.status == 'open'
        && request.resource.data.assigneeUid is string
        && request.resource.data.assigneeName is string
        && (request.resource.data.assigneeUid == '' || activeTechnician(request.resource.data.assigneeUid))
        && request.resource.data.sheet.id == id
        && request.resource.data.sheet.serial is string
        && request.resource.data.sheet.serial.matches('[0-9]{10}')
        && request.resource.data.sheet.actions.size() == 12
        && request.resource.data.createdAt is string;
      allow update: if isManager()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigneeUid', 'assigneeName'])
        && request.resource.data.assigneeUid is string
        && request.resource.data.assigneeName is string
        && activeTechnician(request.resource.data.assigneeUid);
      allow update: if isManager()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sheet'])
        && request.resource.data.sheet.diff(resource.data.sheet).affectedKeys().hasOnly(['managerNotes'])
        && request.resource.data.sheet.managerNotes is string
        && request.resource.data.sheet.managerNotes.size() > resource.data.sheet.get('managerNotes', '').size()
        && request.resource.data.sheet.managerNotes.size() <= 2000;
      allow update: if hasRole('technician')
        && resource.data.status == 'open'
        && resource.data.assigneeUid == request.auth.uid
        && request.resource.data.status == 'pendingReview'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closed'])
        && request.resource.data.closed.keys().hasOnly(['record', 'state'])
        && request.resource.data.closed.record.id == id
        && request.resource.data.closed.record.serial == resource.data.sheet.serial
        && request.resource.data.closed.record.actionsComplete == true
        && request.resource.data.closed.record.closedAt == request.resource.data.closed.state.closedAt
        && request.resource.data.closed.state.actions.size() == 12
        && request.resource.data.closed.state.actions.hasOnly([true])
        && request.resource.data.closed.state.safetyTechnicianSignature is string
        && request.resource.data.closed.state.safetyTechnicianSignature.size() > 100
        && request.resource.data.closed.state.technicianDeclarationSignature is string
        && request.resource.data.closed.state.technicianDeclarationSignature.size() > 100
        && request.resource.data.closed.state.arrivalTime is string
        && request.resource.data.closed.state.arrivalTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && request.resource.data.closed.state.completionTime is string
        && request.resource.data.closed.state.completionTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]');
      allow update: if isManager()
        && resource.data.status == 'pendingReview'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewerSignature'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt is string
        && request.resource.data.reviewerSignature is string
        && request.resource.data.reviewerSignature.size() > 100;
      allow update: if isManager()
        && resource.data.status in ['closed', 'pendingReview']
        && request.resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reopenedAt', 'reopenedBy', 'reopenEvents'])
        && request.resource.data.reopenedBy == request.auth.uid
        && request.resource.data.reopenedAt is string
        && request.resource.data.reopenEvents is list
        && request.resource.data.reopenEvents.size() == resource.data.get('reopenEvents', []).size() + 1
        && request.resource.data.reopenEvents.hasAll(resource.data.get('reopenEvents', []))
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].by == request.auth.uid
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].at == request.resource.data.reopenedAt
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].priorClosedAt == resource.data.closed.state.closedAt;
      allow delete: if false;
    }
  }
}
