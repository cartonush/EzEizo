rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole(role) {
      return request.auth != null &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.role == role &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('active', true) == true &&
        get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('passwordResetRequired', false) == false;
    }
    function isManager() {
      return hasRole('manager');
    }
    function isMagat() {
      return hasRole('technician')
        && get(/databases/$(database)/documents/roles/$(request.auth.uid)).data.get('magatCertified', false) == true;
    }
    function isOperator() {
      return isManager() || isMagat();
    }
    function validManagerReview(data) {
      return data is map
        && data.keys().hasAll(['verified', 'unitsReplaced', 'repairPerformed', 'recurrent', 'recurrentAnswer', 'missionCancelled', 'sortieCancelled', 'inspectionPermitUntil', 'flightPermitUntil', 'trackingPermit', 'approvalUntil'])
        && data.keys().hasOnly(['verified', 'notVerified', 'unitsReplaced', 'repairPerformed', 'recurrent', 'recurrentAnswer', 'missionCancelled', 'sortieCancelled', 'inspectionPermitUntil', 'flightPermitUntil', 'trackingPermit', 'approvalUntil'])
        && data.verified is bool && data.get('notVerified', false) is bool && !(data.verified && data.get('notVerified', false)) && data.unitsReplaced is bool && data.repairPerformed is bool
        && data.recurrent is bool && data.recurrentAnswer in ['', 'yes', 'no']
        && data.recurrent == (data.recurrentAnswer == 'yes')
        && data.missionCancelled is bool && data.sortieCancelled is bool && data.trackingPermit is bool
        && data.inspectionPermitUntil is string && data.inspectionPermitUntil.size() <= 10
        && data.flightPermitUntil is string && data.flightPermitUntil.size() <= 10
        && data.approvalUntil is string && data.approvalUntil.size() <= 10;
    }
    function activeTechnician(uid) {
      return exists(/databases/$(database)/documents/roles/$(uid)) &&
        get(/databases/$(database)/documents/roles/$(uid)).data.role == 'technician' &&
        get(/databases/$(database)/documents/roles/$(uid)).data.active == true;
    }
    function validDutyPerson(uid) {
      return uid == '' || (exists(/databases/$(database)/documents/roles/$(uid))
        && get(/databases/$(database)/documents/roles/$(uid)).data.role in ['technician', 'manager']
        && get(/databases/$(database)/documents/roles/$(uid)).data.get('active', true) == true);
    }
    function validEditLease(data, id) {
      return hasRole('technician')
        && data.keys().hasAll(['kind', 'formId', 'serial', 'ownerUid', 'ownerName', 'session', 'expiresAt'])
        && data.keys().hasOnly(['kind', 'formId', 'serial', 'ownerUid', 'ownerName', 'session', 'expiresAt'])
        && data.ownerUid == request.auth.uid
        && data.ownerName is string && data.ownerName.size() <= 100
        && data.session is string && data.session.size() <= 100
        && data.expiresAt is timestamp && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(2, 'm')
        && id == data.kind + '_' + data.serial
        && (
          (data.kind == 'key' && data.serial == data.formId
            && exists(/databases/$(database)/documents/keyLoads/$(data.formId))
            && get(/databases/$(database)/documents/keyLoads/$(data.formId)).data.status == 'open'
            && request.auth.uid in get(/databases/$(database)/documents/keyLoads/$(data.formId)).data.teamUids)
          || (data.kind == 'issue'
            && exists(/databases/$(database)/documents/issues/$(data.formId))
            && get(/databases/$(database)/documents/issues/$(data.formId)).data.status == 'open'
            && request.auth.uid in get(/databases/$(database)/documents/issues/$(data.formId)).data.get('teamUids', [get(/databases/$(database)/documents/issues/$(data.formId)).data.assigneeUid])
            && get(/databases/$(database)/documents/issues/$(data.formId)).data.sheet.serial == data.serial)
        );
    }
    function validManagerLease(data, id) {
      return isOperator()
        && data.keys().hasAll(['kind', 'formId', 'serial', 'ownerUid', 'ownerName', 'session', 'expiresAt'])
        && data.keys().hasOnly(['kind', 'formId', 'serial', 'ownerUid', 'ownerName', 'session', 'expiresAt'])
        && data.kind == 'issue'
        && data.ownerUid == request.auth.uid
        && data.ownerName is string && data.ownerName.size() <= 100
        && data.session is string && data.session.size() <= 100
        && data.expiresAt is timestamp && data.expiresAt > request.time
        && data.expiresAt <= request.time + duration.value(2, 'm')
        && id == 'issue_' + data.serial
        && exists(/databases/$(database)/documents/issues/$(data.formId))
        && get(/databases/$(database)/documents/issues/$(data.formId)).data.status == 'open'
        && get(/databases/$(database)/documents/issues/$(data.formId)).data.sheet.serial == data.serial;
    }
    function ownsEditLock(id) {
      return exists(/databases/$(database)/documents/editLocks/$(id))
        && get(/databases/$(database)/documents/editLocks/$(id)).data.ownerUid == request.auth.uid
        && get(/databases/$(database)/documents/editLocks/$(id)).data.expiresAt > request.time;
    }
    function ownsIssueLock(issueId, serial) {
      let lockId = 'issue_' + serial;
      return ownsEditLock(lockId)
        && get(/databases/$(database)/documents/editLocks/$(lockId)).data.formId == issueId;
    }
    match /editLocks/{id} {
      allow get: if isOperator() || hasRole('technician');
      allow list: if false;
      allow create: if validEditLease(request.resource.data, id) || validManagerLease(request.resource.data, id);
      allow update: if (validEditLease(request.resource.data, id) || validManagerLease(request.resource.data, id))
        && (resource.data.expiresAt <= request.time
          || (resource.data.ownerUid == request.auth.uid && resource.data.session == request.resource.data.session));
      allow delete: if (hasRole('technician') || isOperator()) && resource.data.ownerUid == request.auth.uid;
    }

    match /roles/{uid} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isOperator();
      allow list: if isOperator();
      allow create: if isManager() && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'personalNumber', 'firstName', 'lastName', 'workStage', 'magatCertified', 'department', 'serviceType', 'rank', 'license', 'active', 'createdAt'])
        && request.resource.data.role == 'technician'
        && request.resource.data.active == true
        && request.resource.data.name is string
        && request.resource.data.get('workStage', '') in ['', '1', '7', '9', '11']
        && request.resource.data.get('magatCertified', false) is bool
        && request.resource.data.email is string
        && (!request.resource.data.keys().hasAny(['personalNumber']) || (request.resource.data.personalNumber is string && request.resource.data.personalNumber.matches('[0-9]{7}')))
        && request.resource.data.createdAt is string;
      allow update: if isManager() && resource.data.role == 'technician'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
        && request.resource.data.active is bool;
      allow update: if isOperator() && resource.data.role in ['technician', 'manager']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendanceStatus'])
        && request.resource.data.attendanceStatus in ['נוכח', 'רענון', 'גימלים', 'בדרך', 'שמירות', 'הפניה', 'אבט״ש', 'ליווי קבלנים', 'רס״ר', 'יוצא', 'בח״א 10', 'נהג מנהלות', 'מחוץ ליחידה', 'הרצאות', 'צוות לילה'];
      allow update: if isManager() && resource.data.role in ['technician', 'manager']
        && !resource.data.keys().hasAny(['personalNumber'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['personalNumber'])
        && request.resource.data.personalNumber is string
        && request.resource.data.personalNumber.matches('[0-9]{7}')
        && getAfter(/databases/$(database)/documents/personalNumbers/$(request.resource.data.personalNumber)).data.uid == uid;
      allow update: if isManager() && resource.data.role in ['technician', 'manager']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'firstName', 'lastName', 'workStage', 'magatCertified', 'department', 'serviceType', 'rank', 'license'])
        && request.resource.data.name == request.resource.data.firstName + ' ' + request.resource.data.lastName
        && request.resource.data.get('firstName', '') is string
        && request.resource.data.get('lastName', '') is string
        && request.resource.data.get('workStage', '') in ['', '1', '7', '9', '11']
        && request.resource.data.get('magatCertified', false) is bool
        && request.resource.data.get('department', '') is string
        && request.resource.data.get('serviceType', '') is string
        && request.resource.data.get('rank', '') in ['', 'טוראי', 'רבט', 'סמל', 'סמר', 'רסל', 'רסר', 'רסמ', 'רסב', 'רנג', 'סגם', 'סגן', 'סרן', 'רסן']
        && request.resource.data.get('license', 'אין') in ['אין', 'אוטומטי', 'ידני'];
      allow delete: if false;
    }

    match /personalNumbers/{number} {
      allow get, list: if isManager();
      allow create: if isManager() && number.matches('[0-9]{7}')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid is string
        && getAfter(/databases/$(database)/documents/roles/$(request.resource.data.uid)).data.personalNumber == number;
      allow delete: if false;
      allow update: if false;
    }

    match /dutyAssignments/{id} {
      allow get, list: if isOperator();
      allow create, update: if isOperator()
        && request.resource.data.keys().hasAll(['week', 'day', 'role', 'assignees', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['week', 'day', 'role', 'assignees', 'updatedAt'])
        && request.resource.data.week is string && request.resource.data.week.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.day in ['0', '1', '2', '3', '4', '5']
        && request.resource.data.role in ['morningDriver', 'dayDriver', 'reinforcement', 'morningTools', 'dayTools', 'garageTeam']
        && id == request.resource.data.week + '_' + request.resource.data.day + '_' + request.resource.data.role
        && request.resource.data.assignees is list
        && request.resource.data.assignees.size() == (request.resource.data.role == 'garageTeam' ? 2 : 1)
        && request.resource.data.assignees[0] is string
        && validDutyPerson(request.resource.data.assignees[0])
        && (request.resource.data.role != 'garageTeam' || (request.resource.data.assignees[1] is string && (request.resource.data.assignees[0] == '' || request.resource.data.assignees[0] != request.resource.data.assignees[1])))
        && (request.resource.data.role != 'garageTeam' || validDutyPerson(request.resource.data.assignees[1]))
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /metadata/{id} {
      allow get: if id in ['serial', 'keySerial'] && isOperator();
      allow list: if false;
      allow create, update: if id in ['serial', 'keySerial'] && isOperator()
        && request.resource.data.keys().hasOnly(['last'])
        && request.resource.data.last is int
        && request.resource.data.last >= 1
        && request.resource.data.last <= (id == 'keySerial' ? 999999999 : 9999999999)
        && (!exists(/databases/$(database)/documents/metadata/$(id)) || request.resource.data.last > resource.data.last);
      allow delete: if false;
    }

    match /aircraftConstants/{id} {
      allow get, list: if isOperator();
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['squadron', 'aircraft', 'constants', 'updatedAt', 'updatedBy'])
        && request.resource.data.squadron in ['101', '105', '109', 'מנ״ט']
        && request.resource.data.aircraft is string
        && id == request.resource.data.squadron + '_' + request.resource.data.aircraft
        && request.resource.data.constants is map
        && request.resource.data.constants.keys().hasOnly(['HUD', 'CTVS', 'CAMERA', 'TFL', 'INS'])
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /systemCatalog/{id} {
      allow get, list: if isManager() || hasRole('technician');
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['name', 'code', 'volume', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.code is string && request.resource.data.code.size() > 0 && request.resource.data.code.size() <= 30
        && request.resource.data.volume is string && request.resource.data.volume.size() <= 30
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }
    match /componentCatalog/{id} {
      allow get, list: if isManager() || hasRole('technician');
      allow create, update: if isManager()
        && request.resource.data.keys().hasOnly(['name', 'systemId', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.systemId is string
        && (request.resource.data.systemId in ['system_fcr', 'system_tcn', 'system_ew'] || exists(/databases/$(database)/documents/systemCatalog/$(request.resource.data.systemId)))
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }

    match /keyLoads/{id} {
      allow get, list: if isOperator() || (hasRole('technician') && request.auth.uid in resource.data.teamUids);
      allow create: if isOperator()
        && request.resource.data.keys().hasOnly(['date', 'time', 'squadron', 'shelter', 'teamUids', 'teamNames', 'rows', 'aircraftIds', 'period', 'dispatcherSignature', 'status', 'createdAt', 'serial'])
        && request.resource.data.serial is string
        && request.resource.data.serial.matches('K-[0-9]{9}')
        && request.resource.data.status == 'open'
        && request.resource.data.teamUids is list
        && request.resource.data.teamUids.size() >= 2
        && request.resource.data.rows is list
        && request.resource.data.rows.size() > 0
        && request.resource.data.aircraftIds.size() == request.resource.data.rows.size()
        && request.resource.data.dispatcherSignature is string
        && request.resource.data.dispatcherSignature.size() > 100;
      allow update: if isOperator()
        && !('serial' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['serial'])
        && request.resource.data.serial is string
        && request.resource.data.serial.matches('K-[0-9]{9}');
      allow update: if hasRole('technician')
        && resource.data.status == 'open'
        && request.auth.uid in resource.data.teamUids
        && ownsEditLock('key_' + id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workDraft', 'draftBy'])
        && request.resource.data.draftBy == request.auth.uid
        && request.resource.data.workDraft is map;
      allow update: if hasRole('technician')
        && resource.data.status == 'open'
        && request.auth.uid in resource.data.teamUids
        && ownsEditLock('key_' + id)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'work', 'completedAt', 'completedBy', 'workDraft'])
        && request.resource.data.status == 'pendingReview'
        && request.resource.data.completedBy == request.auth.uid
        && request.resource.data.completedAt is string
        && request.resource.data.work.actions is list
        && request.resource.data.work.actions.size() == 12
        && request.resource.data.work.actions.hasOnly([true]);
      allow update: if isOperator()
        && resource.data.status == 'open'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancellationReason'])
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledAt is string
        && request.resource.data.cancellationReason is string
        && request.resource.data.cancellationReason.size() > 0
        && request.resource.data.cancellationReason.size() <= 500;
      allow update: if isOperator()
        && resource.data.status == 'pendingReview'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewerSignature', 'managerReview'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt is string
        && request.resource.data.reviewerSignature is string
        && request.resource.data.reviewerSignature.size() > 100
        && validManagerReview(request.resource.data.managerReview);
      allow update: if isOperator()
        && resource.data.status in ['pendingReview', 'closed']
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerReview', 'reviewUpdatedAt', 'reviewUpdatedBy'])
        && request.resource.data.reviewUpdatedBy == request.auth.uid
        && request.resource.data.reviewUpdatedAt is string
        && validManagerReview(request.resource.data.managerReview);
      allow update: if isOperator()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerNotes'])
        && request.resource.data.managerNotes is string
        && request.resource.data.managerNotes.size() > resource.data.get('managerNotes', '').size()
        && request.resource.data.managerNotes.size() <= 2000;
      allow update: if isOperator()
        && resource.data.status in ['closed', 'pendingReview']
        && request.resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reopenedAt', 'reopenedBy', 'reopenEvents'])
        && request.resource.data.reopenedBy == request.auth.uid
        && request.resource.data.reopenedAt is string
        && request.resource.data.reopenEvents is list
        && request.resource.data.reopenEvents.size() == resource.data.get('reopenEvents', []).size() + 1
        && request.resource.data.reopenEvents.hasAll(resource.data.get('reopenEvents', []))
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].by == request.auth.uid
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].at == request.resource.data.reopenedAt
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].priorCompletedAt == resource.data.completedAt;
      allow delete: if false;
    }

    match /keyHistory/{id} {
      allow get, list: if isOperator();
      allow create, update: if hasRole('technician')
        && request.resource.data.keys().hasOnly(['squadron', 'aircraft', 'date', 'period', 'completedAt', 'loadId'])
        && (!exists(/databases/$(database)/documents/keyHistory/$(id)) || request.resource.data.completedAt > resource.data.completedAt)
        && id == request.resource.data.squadron + '_' + request.resource.data.aircraft
        && request.resource.data.loadId is string
        && existsAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId))
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.status == 'closed'
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.completedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.squadron == request.resource.data.squadron
        && request.resource.data.aircraft in getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.aircraftIds
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.period == request.resource.data.period
        && getAfter(/databases/$(database)/documents/keyLoads/$(request.resource.data.loadId)).data.completedAt == request.resource.data.completedAt;
      allow delete: if false;
    }

    match /issues/{id} {
      allow get, list: if isOperator() || (hasRole('technician') && (resource.data.assigneeUid == request.auth.uid || request.auth.uid in resource.data.get('teamUids', [])));
      allow create: if isOperator()
        && request.resource.data.keys().hasOnly(['sheet', 'status', 'createdAt', 'assigneeUid', 'assigneeName', 'teamUids', 'teamNames'])
        && request.resource.data.status == 'open'
        && request.resource.data.assigneeUid is string
        && request.resource.data.assigneeName is string
        && (request.resource.data.assigneeUid == '' || activeTechnician(request.resource.data.assigneeUid))
        && (!request.resource.data.keys().hasAny(['teamUids']) || (request.resource.data.teamUids is list
          && request.resource.data.teamUids.size() >= 2 && request.resource.data.teamUids.size() <= 10
          && request.resource.data.assigneeUid in request.resource.data.teamUids
          && request.resource.data.teamNames is list
          && request.resource.data.teamNames.size() == request.resource.data.teamUids.size()))
        && request.resource.data.sheet.id == id
        && request.resource.data.sheet.serial is string
        && request.resource.data.sheet.serial.matches('[0-9]{10}')
        && request.resource.data.sheet.actions.size() == 12
        && request.resource.data.createdAt is string;
      allow update: if isOperator()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigneeUid', 'assigneeName'])
        && request.resource.data.assigneeUid is string
        && request.resource.data.assigneeName is string
        && activeTechnician(request.resource.data.assigneeUid);
      allow update: if isOperator() && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sheet', 'assigneeUid', 'assigneeName', 'teamUids', 'teamNames', 'definitionUpdatedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['definitionUpdatedAt'])
        && request.resource.data.sheet.id == id
        && request.resource.data.sheet.serial == resource.data.sheet.serial
        && request.resource.data.teamUids is list
        && request.resource.data.teamUids.size() >= 2 && request.resource.data.teamUids.size() <= 10
        && request.resource.data.teamNames is list
        && request.resource.data.teamNames.size() == request.resource.data.teamUids.size()
        && request.resource.data.assigneeUid == request.resource.data.teamUids[0]
        && activeTechnician(request.resource.data.assigneeUid)
        && request.resource.data.definitionUpdatedAt is string
        && ownsEditLock('issue_' + resource.data.sheet.serial)
        && get(/databases/$(database)/documents/editLocks/$("issue_" + resource.data.sheet.serial)).data.formId == id;
      allow update: if isOperator()
        && resource.data.status == 'open'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy', 'cancellationReason'])
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.cancelledAt is string
        && request.resource.data.cancellationReason is string
        && request.resource.data.cancellationReason.size() > 0
        && request.resource.data.cancellationReason.size() <= 500;
      allow update: if isOperator()
        && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sheet'])
        && request.resource.data.sheet.diff(resource.data.sheet).affectedKeys().hasOnly(['managerNotes'])
        && request.resource.data.sheet.managerNotes is string
        && request.resource.data.sheet.managerNotes.size() > resource.data.sheet.get('managerNotes', '').size()
        && request.resource.data.sheet.managerNotes.size() <= 2000;
      allow update: if hasRole('technician')
        && resource.data.status == 'open'
        && request.auth.uid in resource.data.get('teamUids', [resource.data.assigneeUid])
        && ownsIssueLock(id, resource.data.sheet.serial)
        && !resource.data.keys().hasAny(['startedAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startedAt', 'startedBy', 'safetySignature'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['startedAt', 'startedBy', 'safetySignature'])
        && request.resource.data.startedAt is string
        && request.resource.data.startedBy == request.auth.uid
        && request.resource.data.safetySignature is string
        && request.resource.data.safetySignature.matches('data:image/png;base64,.*')
        && request.resource.data.safetySignature.size() > 100
        && resource.data.keys().hasAny(['intake']);
      allow update: if hasRole('technician')
        && resource.data.status == 'open'
        && request.auth.uid in resource.data.get('teamUids', [resource.data.assigneeUid])
        && ownsIssueLock(id, resource.data.sheet.serial)
        && !resource.data.keys().hasAny(['startedAt', 'intake'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['intake', 'acceptedTools'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['intake', 'acceptedTools'])
        && request.resource.data.intake is map
        && request.resource.data.intake.choice in ['yes', 'no']
        && request.resource.data.intake.by == request.auth.uid
        && request.resource.data.intake.at is string
        && request.resource.data.intake.tools is list
        && request.resource.data.intake.taken is list
        && request.resource.data.intake.tools.size() <= 100
        && request.resource.data.intake.taken.size() <= 100
        && request.resource.data.acceptedTools == request.resource.data.intake.tools
        && (request.resource.data.intake.choice == 'yes'
          ? request.resource.data.intake.tools.size() + request.resource.data.intake.taken.size() > 0
          : request.resource.data.intake.tools.size() + request.resource.data.intake.taken.size() == 0)
        && (request.resource.data.intake.tools.size() == 0 ||
          (request.resource.data.intake.entryTechnicianSignature is string
          && request.resource.data.intake.entryTechnicianSignature.size() > 100
          && request.resource.data.intake.entryInspectorSignature is string
          && request.resource.data.intake.entryInspectorSignature.size() > 100
          && request.resource.data.intake.entryInspectorNumber.matches('[0-9]{1,7}')))
        && (request.resource.data.intake.taken.size() == 0 ||
          (request.resource.data.intake.takenSignature is string
          && request.resource.data.intake.takenSignature.size() > 100
          && request.resource.data.intake.takenPersonalNumber.matches('[0-9]{1,7}')));
      allow update: if hasRole('technician')
        && resource.data.status == 'open'
        && resource.data.keys().hasAll(['startedAt', 'intake', 'acceptedTools'])
        && request.auth.uid in resource.data.get('teamUids', [resource.data.assigneeUid])
        && ownsIssueLock(id, resource.data.sheet.serial)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedTools', 'toolIntakes'])
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['acceptedTools', 'toolIntakes'])
        && request.resource.data.toolIntakes is list
        && request.resource.data.toolIntakes.size() == resource.data.get('toolIntakes', []).size() + 1
        && request.resource.data.toolIntakes.hasAll(resource.data.get('toolIntakes', []))
        && request.resource.data.toolIntakes[request.resource.data.toolIntakes.size() - 1].by == request.auth.uid
        && request.resource.data.toolIntakes[request.resource.data.toolIntakes.size() - 1].tools is list
        && request.resource.data.toolIntakes[request.resource.data.toolIntakes.size() - 1].tools.size() > 0
        && request.resource.data.toolIntakes[request.resource.data.toolIntakes.size() - 1].technicianSignature.size() > 100
        && request.resource.data.toolIntakes[request.resource.data.toolIntakes.size() - 1].inspectorSignature.size() > 100
        && request.resource.data.toolIntakes[request.resource.data.toolIntakes.size() - 1].inspectorNumber.matches('[0-9]{1,7}')
        && request.resource.data.acceptedTools.size() == resource.data.acceptedTools.size() + request.resource.data.toolIntakes[request.resource.data.toolIntakes.size() - 1].tools.size()
        && request.resource.data.acceptedTools.hasAll(resource.data.acceptedTools)
        && request.resource.data.acceptedTools.hasAll(request.resource.data.toolIntakes[request.resource.data.toolIntakes.size() - 1].tools);
      allow update: if hasRole('technician')
        && resource.data.status == 'open'
        && request.auth.uid in resource.data.get('teamUids', [resource.data.assigneeUid])
        && ownsIssueLock(id, resource.data.sheet.serial)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workDraft'])
        && request.resource.data.workDraft is map
        && request.resource.data.workDraft.keys().hasOnly(['state', 'savedAt', 'savedBy'])
        && request.resource.data.workDraft.savedBy == request.auth.uid
        && request.resource.data.workDraft.savedAt is string
        && request.resource.data.workDraft.state is map
        && request.resource.data.workDraft.state.actions is list
        && request.resource.data.workDraft.state.actions.size() == 12
        && (!resource.data.keys().hasAny(['acceptedTools']) || request.resource.data.workDraft.state.tools == resource.data.acceptedTools)
        && resource.data.keys().hasAny(['startedAt']);
      allow update: if hasRole('technician')
        && resource.data.status == 'open'
        && request.auth.uid in resource.data.get('teamUids', [resource.data.assigneeUid])
        && ownsIssueLock(id, resource.data.sheet.serial)
        && request.resource.data.status == 'pendingReview'
        && resource.data.keys().hasAny(['startedAt'])
        && request.resource.data.closed.state.get('preflightSaved', false) == true
        && request.resource.data.closed.state.get('repairClassification', '') in ['verified', 'notVerified', 'notFault']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'closed', 'workDraft'])
        && request.resource.data.closed.keys().hasOnly(['record', 'state'])
        && request.resource.data.closed.record.id == id
        && request.resource.data.closed.record.serial == resource.data.sheet.serial
        && (!resource.data.keys().hasAny(['acceptedTools']) || request.resource.data.closed.state.tools == resource.data.acceptedTools)
        && request.resource.data.closed.record.actionsComplete == true
        && request.resource.data.closed.record.closedAt == request.resource.data.closed.state.closedAt
        && request.resource.data.closed.state.actions.size() == 12
        && request.resource.data.closed.state.actions.hasOnly([true])
        && request.resource.data.closed.state.safetyTechnicianSignature is string
        && request.resource.data.closed.state.safetyTechnicianSignature.size() > 100
        && request.resource.data.closed.state.technicianDeclarationSignature is string
        && request.resource.data.closed.state.technicianDeclarationSignature.size() > 100
        && request.resource.data.closed.state.arrivalTime is string
        && request.resource.data.closed.state.arrivalTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]')
        && request.resource.data.closed.state.completionTime is string
        && request.resource.data.closed.state.completionTime.matches('([01][0-9]|2[0-3]):[0-5][0-9]');
      allow update: if isOperator()
        && resource.data.status == 'pendingReview'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewerSignature', 'managerReview'])
        && validManagerReview(request.resource.data.managerReview)
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt is string
        && request.resource.data.reviewerSignature is string
        && request.resource.data.reviewerSignature.size() > 100;
      allow update: if isManager()
        && resource.data.status in ['open', 'pendingReview']
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys().hasAll(['status', 'reviewedAt', 'reviewedBy', 'paperClosure'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy', 'paperClosure', 'closed'])
        && request.resource.data.reviewedBy == request.auth.uid
        && request.resource.data.reviewedAt is string
        && request.resource.data.paperClosure is map
        && request.resource.data.paperClosure.keys().hasOnly(['at', 'by', 'template'])
        && request.resource.data.paperClosure.keys().hasAll(['at', 'by', 'template'])
        && request.resource.data.paperClosure.at == request.resource.data.reviewedAt
        && request.resource.data.paperClosure.by == request.auth.uid
        && request.resource.data.paperClosure.template == 'v1.9.20'
        && (
          (resource.data.status == 'pendingReview' && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['closed']))
          || (resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasAll(['closed'])
            && request.resource.data.closed.keys().hasOnly(['record', 'state'])
            && request.resource.data.closed.keys().hasAll(['record', 'state'])
            && request.resource.data.closed.record.keys().hasOnly(['id', 'serial', 'aircraft', 'location', 'fault', 'closedAt', 'actionsComplete', 'paper'])
            && request.resource.data.closed.record.id == id
            && request.resource.data.closed.record.serial == resource.data.sheet.serial
            && request.resource.data.closed.record.closedAt == request.resource.data.reviewedAt
            && request.resource.data.closed.record.actionsComplete == false
            && request.resource.data.closed.record.paper == true
            && request.resource.data.closed.state.keys().hasOnly(['closedAt', 'paper'])
            && request.resource.data.closed.state.closedAt == request.resource.data.reviewedAt
            && request.resource.data.closed.state.paper == true)
        );
      allow update: if isOperator()
        && resource.data.status == 'pendingReview'
        && request.resource.data.status == 'pendingReview'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerReview', 'reviewUpdatedAt', 'reviewUpdatedBy'])
        && validManagerReview(request.resource.data.managerReview)
        && request.resource.data.reviewUpdatedBy == request.auth.uid
        && request.resource.data.reviewUpdatedAt is string;
      allow update: if isOperator()
        && resource.data.status == 'closed'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerReview', 'reviewUpdatedAt', 'reviewUpdatedBy'])
        && validManagerReview(request.resource.data.managerReview)
        && request.resource.data.reviewUpdatedBy == request.auth.uid
        && request.resource.data.reviewUpdatedAt is string;
      allow update: if isOperator()
        && resource.data.status in ['closed', 'pendingReview']
        && request.resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reopenedAt', 'reopenedBy', 'reopenEvents', 'paperClosure'])
        && (!resource.data.keys().hasAny(['paperClosure']) || !request.resource.data.keys().hasAny(['paperClosure']))
        && request.resource.data.reopenedBy == request.auth.uid
        && request.resource.data.reopenedAt is string
        && request.resource.data.reopenEvents is list
        && request.resource.data.reopenEvents.size() == resource.data.get('reopenEvents', []).size() + 1
        && request.resource.data.reopenEvents.hasAll(resource.data.get('reopenEvents', []))
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].by == request.auth.uid
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].at == request.resource.data.reopenedAt
        && request.resource.data.reopenEvents[request.resource.data.reopenEvents.size() - 1].priorClosedAt == resource.data.closed.state.closedAt;
      allow delete: if false;
    }
  }
}
